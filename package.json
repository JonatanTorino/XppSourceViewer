{
  "name": "xpp-source-viewer",
  "displayName": "X++ Source Viewer for Dynamics 365 F&O",
  "description": "Read the X++ source hidden in your Dynamics 365 Finance & Operations metadata XML, reconstructed as readable .xpp.",
  "version": "0.1.0",
  "publisher": "JonatanTorino",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "x++",
    "xpp",
    "dynamics 365",
    "finance and operations",
    "d365fo",
    "ax",
    "metadata",
    "xml",
    "axclass",
    "aot"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:xml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xpp",
        "aliases": [
          "X++",
          "xpp"
        ],
        "extensions": [
          ".xpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xpp",
        "scopeName": "source.xpp",
        "path": "./syntaxes/xpp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "xpp.transpile.toggle",
        "title": "View as X++",
        "category": "X++",
        "icon": "$(file-code)"
      },
      {
        "command": "xpp.transpile.saveAs",
        "title": "Export to .xpp file",
        "category": "X++",
        "icon": "$(save-as)"
      },
      {
        "command": "xpp.transpile.folder",
        "title": "Export metadata folder to .xpp",
        "category": "X++"
      },
      {
        "command": "xpp.transpile.toggleAuto",
        "title": "Pause or resume automatic opening",
        "category": "X++"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xpp.transpile.toggle",
          "when": "resourceLangId == xml && xpp:isMetadata",
          "group": "navigation@1"
        },
        {
          "command": "xpp.transpile.saveAs",
          "when": "resourceScheme == 'xpp-preview'",
          "group": "navigation@1"
        },
        {
          "command": "xpp.transpile.toggle",
          "when": "resourceScheme == 'xpp-preview'",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "xpp.transpile.folder",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "xpp.transpile.saveAs",
          "when": "resourceLangId == xml",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "xpp.transpile.toggle",
          "when": "resourceLangId == xml || resourceScheme == 'xpp-preview'"
        },
        {
          "command": "xpp.transpile.saveAs",
          "when": "resourceLangId == xml || resourceScheme == 'xpp-preview'"
        }
      ]
    },
    "configuration": {
      "title": "X++ Source Viewer",
      "properties": {
        "xpp.transpile.autoPreview": {
          "type": "string",
          "enum": [
            "never",
            "ask",
            "onOpen"
          ],
          "default": "never",
          "enumDescriptions": [
            "Do nothing when a metadata XML is opened.",
            "Ask with a notification, without stealing focus.",
            "Open the X++ view automatically."
          ],
          "description": "When to automatically open the X++ view of a metadata XML."
        },
        "xpp.transpile.autoPreviewTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Artifact types that open on their own, for example `[\"AxClass\", \"AxForm\"]`. Empty = all of them. This only affects automatic opening; the commands keep working with any type."
        },
        "xpp.transpile.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Path globs where automatic opening is allowed, for example `[\"**/Metadata/**\"]`. Empty = everywhere."
        },
        "xpp.transpile.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Path globs where it never opens on its own. Takes precedence over `#xpp.transpile.include#`."
        },
        "xpp.transpile.skipEmpty": {
          "type": "boolean",
          "default": true,
          "description": "Do not open the view for artifacts with no X++ source, such as staging tables."
        },
        "xpp.transpile.viewColumn": {
          "type": "string",
          "enum": [
            "beside",
            "active",
            "replace"
          ],
          "default": "beside",
          "enumDescriptions": [
            "Open beside it, keeping the XML visible.",
            "Open in the active column, without closing the XML.",
            "Open in the active column as a pinned tab, covering the XML."
          ],
          "description": "Where the X++ view opens."
        },
        "xpp.transpile.preserveFocus": {
          "type": "boolean",
          "default": true,
          "description": "Keep the cursor in the XML when the view opens by itself, beside the XML. This only applies to automatic opening: running the command or pressing the shortcut always moves focus to the X++ view, because that is what you asked for."
        },
        "xpp.transpile.stripDocComments": {
          "type": "boolean",
          "default": false,
          "description": "Strip /// documentation comments from the generated X++, for a more compact read."
        },
        "xpp.transpile.headerComment": {
          "type": "boolean",
          "default": false,
          "description": "Prepend a header with the type, the name, the method count and the source path."
        },
        "xpp.transpile.eol": {
          "type": "string",
          "enum": [
            "crlf",
            "lf"
          ],
          "default": "crlf",
          "description": "Line ending of the generated X++. D365FO uses CRLF."
        },
        "xpp.transpile.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Target folder for exported .xpp files. Empty = next to the source XML."
        }
      }
    },
    "keybindings": [
      {
        "command": "xpp.transpile.toggle",
        "key": "ctrl+alt+x",
        "when": "resourceLangId == xml || resourceScheme == 'xpp-preview'"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run compile:core && node --test out/test/transpiler.test.js out/test/exportLayout.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish",
    "compile:core": "tsc -p tsconfig.core.json"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "1.90.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JonatanTorino/XppSourceViewer.git"
  },
  "bugs": {
    "url": "https://github.com/JonatanTorino/XppSourceViewer/issues"
  },
  "homepage": "https://github.com/JonatanTorino/XppSourceViewer#readme"
}
